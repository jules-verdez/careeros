CAREEROS_DATABASE_URL=sqlite:///career.db
CAREEROS_TIMEZONE=UTC
CAREEROS_CANDIDATE_NAME=Your Name
CAREEROS_APPROVAL_REQUIRED=true
# People CareerOS must never draft for, queue, approve, or send to. Separate entries with
# commas or semicolons: a full name, an exact address, or @domain. Approval cannot override it.
CAREEROS_DO_NOT_CONTACT=

# Connector secrets are unprefixed: Settings owns CAREEROS_*, and provider
# credentials stay out of the domain layer. Each connector reads these directly
# from the environment after the CLI loads only the current directory's .env.
APIFY_TOKEN=
HUNTER_API_KEY=
PROSPEO_API_KEY=
BRAVE_SEARCH_API_KEY=
EXPLORIUM_API_KEY=
CLAY_WEBHOOK_URL=
CLAY_WEBHOOK_TOKEN=
CLAY_WEBHOOK_AUTH_HEADER=
